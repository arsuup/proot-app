# URL publique du Worker Cloudflare, à copier après `npm run deploy`.
# Elle doit finir par /ai. N'ajoute jamais de clé Gemini ou Cloudflare dans l'app.
EXPO_PUBLIC_ROOT_AI_URL=https://proot-root-ai.<ton-sous-domaine>.workers.dev/ai

# OAuth Google : l'ID client est public, mais n'ajoute jamais un client secret ici.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
